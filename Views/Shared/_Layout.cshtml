<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Taquilla</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-wrapper">
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">🎟</div>
            <div class="sidebar-logo-text">
                <strong>Grand Stage</strong>
                <span>Taquilla</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a asp-controller="Dashboard" asp-action="Index"
               class="@(ViewData["Section"]?.ToString() == "dashboard" ? "active" : "")">
                <span class="nav-icon">⊞</span> Dashboard
            </a>
            <a asp-controller="Sale" asp-action="Create" asp-route-eventoId="0"
               class="@(ViewData["Section"]?.ToString() == "boxoffice" ? "active" : "")">
                <span class="nav-icon">🎫</span> Box Office
            </a>
        </nav>

        <div class="sidebar-footer">
            @{
            var emp = Context.Session.GetString("employee");
            }
            @if (emp != null)
            {
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit">↩ Sign Out</button>
            </form>
            }
        </div>
    </aside>

    <main class="main-content">
        @if (TempData["message"] != null)
        {
        var isOk = TempData["success"]?.ToString() == "True";
        <div class="alert @(isOk ? "alert-success" : "alert-danger") no-print">
            @TempData["message"]
        </div>
        }
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>