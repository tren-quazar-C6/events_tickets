@model List<events_tickets.Models.EventoResumen>
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "dashboard";
    var employee = ViewBag.Employee as events_tickets.Models.Employee;
}

<div class="page-header">
    <div>
        <div class="page-title">Eventos disponibles</div>
        <div class="page-subtitle">Selecciona un evento para vender entradas</div>
    </div>
    @if (employee != null)
    {
        <div style="text-align:right;">
            <div style="font-weight:600;">@employee.Nombre</div>
            <div class="text-sm text-muted">@employee.Rol</div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay eventos disponibles en este momento.</div>
}
else
{
    <div class="card" style="padding:0; overflow:hidden;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Tipo</th>
                    <th>Fecha</th>
                    <th>Precio desde</th>
                    <th>Disponibles</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    var now = DateTime.UtcNow;
                    var ventasAbiertas = now >= ev.FechaInicioVentas && now <= ev.FechaFinVentas;

                    <tr>
                        <td>
                            <div style="font-weight:600;">@ev.NombreEvento</div>
                            @if (!string.IsNullOrEmpty(ev.Descripcion))
                            {
                                <div class="text-sm text-muted">@ev.Descripcion</div>
                            }
                        </td>
                        <td><span class="badge badge-info">@ev.TipoEvento</span></td>
                        <td class="text-sm">@ev.FechaEvento.ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="fw-bold">
                            @(ev.PrecioDesde.HasValue ? "$" + ev.PrecioDesde.Value.ToString("N0") : "—")
                        </td>
                        <td>
                            @if (ev.AsientosDisponibles == 0)
                            {
                                <span class="badge badge-danger">Agotado</span>
                            }
                            else if (ev.AsientosDisponibles <= 10)
                            {
                                <span class="badge badge-warning">@ev.AsientosDisponibles restantes</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@ev.AsientosDisponibles</span>
                            }
                        </td>
                        <td>
                            @if (ventasAbiertas && ev.AsientosDisponibles > 0)
                            {
                                <a asp-controller="Sale" asp-action="Create"
                                   asp-route-eventoId="@ev.IdEvento"
                                   class="btn btn-accent btn-sm">
                                    Vender entradas
                                </a>
                            }
                            else if (!ventasAbiertas)
                            {
                                <span class="text-sm text-muted">Ventas cerradas</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}