@model events_tickets.Dtos.VentaDetalleDto
@{
    ViewData["Title"] = "Tickets";
    ViewData["Section"] = "boxoffice";
}

<div class="page-header no-print">
    <div>
        <div class="page-title">Venta #@Model.IdVenta completada</div>
        <div class="page-subtitle">@Model.Tickets.Count entrada(s) — @Model.NombreCliente</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline">← Dashboard</a>
        <form asp-controller="Ticket" asp-action="Reprint" asp-route-ventaId="@Model.IdVenta" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-accent">🖨 Reimprimir</button>
        </form>
    </div>
</div>

@if (ViewBag.EmailSent == true)
{
    <div class="alert alert-success no-print">
        Tickets enviados a <strong>@Model.EmailCliente</strong>. Se están imprimiendo ahora.
    </div>
}
else if (ViewBag.EmailSent == false)
{
    <div class="alert alert-warning no-print">
        La venta se completó, pero no se pudo enviar el email a <strong>@Model.EmailCliente</strong>.
        Revisa las credenciales SMTP en <code>appsettings.json</code>.
    </div>
}

@* @if (ViewBag.PrintStatus is string printStatus && !string.IsNullOrWhiteSpace(printStatus)) *@
@* { *@
@*     <div class="alert alert-info no-print">@printStatus</div> *@
@* } *@

@foreach (var ticket in Model.Tickets)
{
    <div class="ticket-card">
        <div class="ticket-info">
            <div class="ticket-event">@ticket.EventName</div>
            <div class="ticket-date">📅 @ticket.EventDate?.ToString("dddd dd 'de' MMMM yyyy — HH:mm", new System.Globalization.CultureInfo("es-AR"))</div>
            @if (!string.IsNullOrEmpty(ticket.SeatInfo))
            {
                <div class="ticket-seat mt-1">🪑 @ticket.SeatInfo</div>
            }
            <div class="ticket-code">Código: @ticket.Code</div>
        </div>
        <div class="ticket-qr">
            @if (!string.IsNullOrEmpty(ticket.QrCode))
            {
                <img src="data:image/png;base64,@ticket.QrCode" alt="QR" style="width:90px;height:90px;" />
            }
            else
            {
                <div style="width:90px;height:90px;background:#f3f4f6;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#9ca3af;font-size:0.75rem;">QR</div>
            }
            <div class="ticket-price">$@ticket.Price.ToString("N0")</div>
        </div>
    </div>
}

<style>
@@media print {
    @@page {
        size: 72mm auto;
        margin: 2mm;
    }

    body {
        width: 68mm;
        margin: 0 auto;
        font-size: 11px;
        line-height: 1.2;
    }

    .page-header,
    .alert,
    .no-print,
    nav,
    footer {
        display: none !important;
    }

    .ticket-card {
        display: block !important;
        width: 100% !important;
        border: 1px dashed #000;
        border-radius: 0;
        box-shadow: none;
        padding: 6px;
        margin: 0 0 6px 0;
        page-break-inside: avoid;
    }

    .ticket-info,
    .ticket-qr {
        width: 100% !important;
        display: block !important;
        text-align: left !important;
    }

    .ticket-event,
    .ticket-date,
    .ticket-seat,
    .ticket-code,
    .ticket-price {
        word-break: break-word;
        white-space: normal;
    }

    .ticket-qr img {
        width: 72px !important;
        height: 72px !important;
        display: block;
        margin-top: 4px;
    }
}
</style>
