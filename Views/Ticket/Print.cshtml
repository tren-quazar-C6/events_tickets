@model events_tickets.Dtos.VentaDetalleDto
@{
    ViewData["Title"] = "Tickets";
    ViewData["Section"] = "boxoffice";
}

<div class="page-header no-print">
    <div>
        <div class="page-title">Venta #@Model.IdVenta completada</div>
        <div class="page-subtitle">@Model.Tickets.Count entrada(s) — @Model.NombreCliente</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline">← Dashboard</a>
        <button onclick="window.print()" class="btn btn-accent">🖨 Reimprimir</button>
    </div>
</div>

<div class="alert alert-success no-print">
    Tickets enviados a <strong>@Model.EmailCliente</strong>. Se están imprimiendo ahora.
</div>

@foreach (var ticket in Model.Tickets)
{
    <div class="ticket-card">
        <div class="ticket-info">
            <div class="ticket-event">@ticket.EventName</div>
            <div class="ticket-date">📅 @ticket.EventDate?.ToString("dddd dd 'de' MMMM yyyy — HH:mm", new System.Globalization.CultureInfo("es-AR"))</div>
            @if (!string.IsNullOrEmpty(ticket.SeatInfo))
            {
                <div class="ticket-seat mt-1">🪑 @ticket.SeatInfo</div>
            }
            <div class="ticket-code">Código: @ticket.Code</div>
        </div>
        <div class="ticket-qr">
            @if (!string.IsNullOrEmpty(ticket.QrCode))
            {
                <img src="data:image/png;base64,@ticket.QrCode" alt="QR" style="width:90px;height:90px;" />
            }
            else
            {
                <div style="width:90px;height:90px;background:#f3f4f6;border-radius:8px;display:flex;align-items:center;justify-content:center;color:#9ca3af;font-size:0.75rem;">QR</div>
            }
            <div class="ticket-price">$@ticket.Price.ToString("N0")</div>
        </div>
    </div>
}

@section Scripts {
    <script>
    window.addEventListener('load', function () { window.print(); });
</script>
}