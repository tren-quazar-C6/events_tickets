@model events_tickets.Models.SaleViewModel
@{
    ViewData["Title"] = "Box Office";
    ViewData["Section"] = "boxoffice";
    var zonas = Model.AsientosDisponibles.GroupBy(a => a.Zona).ToList();
    var filasPorZona = Model.AsientosDisponibles
        .GroupBy(a => a.Zona)
        .ToDictionary(
            g => g.Key ?? "General",
            g => g.GroupBy(a => a.Fila).OrderBy(f => f.Key).ToList()
        );
}

<div class="page-header mb-2">
    <div class="page-title">
        @Model.Evento?.NombreEvento
    </div>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline btn-sm">← Volver</a>
</div>

<div class="event-bar mb-2">
    <div class="event-bar-chip">
        📅 @Model.Evento?.FechaEvento.ToString("dd MMM, HH:mm")
    </div>
    <div class="event-bar-chip">
        🎭 @Model.Evento?.TipoEvento
    </div>
    <div class="event-bar-chip active">
        🎫 Nueva Venta
    </div>
    <div class="text-sm text-muted" style="margin-left:auto;">
        <span class="badge badge-success">@Model.Evento?.AsientosDisponibles disponibles</span>
    </div>
</div>

<form asp-action="Store" method="post" id="saleForm">
    <input type="hidden" asp-for="EventoId" />
    <input type="hidden" name="asientosJson" id="asientosJson" value="[]" />

    <div class="sale-wrapper">

        <!-- LEFT: Seat map -->
        <div class="sale-left">
            <div class="seat-map-card">
                <div class="stage">ESCENARIO</div>

                <div class="seat-legend">
                    <div class="legend-item"><div class="legend-dot available"></div> Disponible</div>
                    <div class="legend-item"><div class="legend-dot selected"></div> Seleccionado</div>
                    <div class="legend-item"><div class="legend-dot occupied"></div> Ocupado</div>
                </div>

                @if (!Model.AsientosDisponibles.Any())
                {
                    <div style="text-align:center; color:var(--muted); padding:40px 0;">
                        No hay asientos disponibles para este evento.
                    </div>
                }

                @foreach (var zonaKv in filasPorZona)
                {
                    <div class="zone-label">@zonaKv.Key</div>
                    <div class="seat-grid">
                        @foreach (var fila in zonaKv.Value)
                        {
                            <div class="seat-row">
                                <span class="row-label">@fila.Key</span>
                                @foreach (var asiento in fila.OrderBy(a => a.Numero))
                                {
                                    var disponible = asiento.Estado?.ToLower() == "disponible";
                                    <button type="button"
                                            class="seat @(!disponible ? "" : "")"
                                            data-id="@asiento.IdEventoAsiento"
                                            data-precio="@asiento.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-codigo="@asiento.CodigoAsiento"
                                            data-zona="@asiento.Zona"
                                            data-fila="@asiento.Fila"
                                            data-numero="@asiento.Numero"
                                            @(!disponible ? "disabled" : "")
                                            title="@asiento.CodigoAsiento — $@asiento.Precio.ToString("N0")">
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT: Order panel -->
        <div class="sale-right">
            <div class="order-panel">
                <div class="order-header">
                    <span class="order-title">Tu Pedido</span>
                    <span class="order-count" id="seatCount">0 butacas</span>
                </div>

                <!-- Customer form -->
                <div class="customer-form">
                    <div class="customer-form-title">Cliente</div>
                    <input asp-for="CustomerName" class="form-control" placeholder="Nombre completo *" required />
                    <input asp-for="CustomerDocument" class="form-control" placeholder="Documento / DNI *" required />
                    <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="Email *" required />
                    <input asp-for="CustomerPhone" class="form-control" placeholder="Teléfono (opcional)" />
                </div>

                <div class="order-body" id="seatList">
                    <div class="order-empty" id="emptyMsg">
                        Seleccioná asientos en el mapa
                    </div>
                </div>

                <div class="order-divider"></div>

                <div class="order-totals">
                    <div class="total-row">
                        <span>Subtotal</span>
                        <span id="subtotalLabel">$0</span>
                    </div>
                    <div class="total-row grand">
                        <span>TOTAL</span>
                        <span id="totalLabel">$0</span>
                    </div>
                </div>

                <div class="order-footer">
                    <div class="payment-btns">
                        <button type="button" class="btn-payment active" id="btnEfectivo" onclick="selectPayment('efectivo')">
                            💵 Efectivo
                        </button>
                        <button type="button" class="btn-payment" id="btnTarjeta" onclick="selectPayment('tarjeta')">
                            💳 Tarjeta
                        </button>
                    </div>
                    <input type="hidden" name="MetodoPago" id="metodoPago" value="efectivo" />
                    <button type="submit" class="btn btn-accent btn-lg" id="confirmBtn" disabled>
                        🖨 Confirmar Venta
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    const selected = new Map(); // idEventoAsiento -> {precio, codigo, zona, fila, numero}
    const cargo_servicio = 0; // update if API returns service charge per zone

    function fmt(n) { return '$' + n.toLocaleString('es-AR', {minimumFractionDigits: 0}); }

    function refresh() {
        const count = selected.size;
        document.getElementById('seatCount').textContent = count + (count === 1 ? ' butaca' : ' butacas');
        document.getElementById('asientosJson').value = JSON.stringify([...selected.keys()]);

        const subtotal = [...selected.values()].reduce((s, x) => s + x.precio, 0);
        document.getElementById('subtotalLabel').textContent = fmt(subtotal);
        document.getElementById('totalLabel').textContent = fmt(subtotal);

        const list = document.getElementById('seatList');
        const emptyMsg = document.getElementById('emptyMsg');
        const confirmBtn = document.getElementById('confirmBtn');

        if (count === 0) {
            list.innerHTML = '<div class="order-empty" id="emptyMsg">Seleccioná asientos en el mapa</div>';
            confirmBtn.disabled = true;
            return;
        }

        confirmBtn.disabled = false;
        let html = '';
        for (const [id, s] of selected) {
            html += `
            <div class="seat-item">
                <div class="seat-item-icon">🪑</div>
                <div class="seat-item-info">
                    <div class="seat-item-name">Fila ${s.fila}, Asiento ${s.numero}</div>
                    <div class="seat-item-zone">${s.zona}</div>
                </div>
                <div class="seat-item-price">${fmt(s.precio)}</div>
            </div>`;
        }
        list.innerHTML = html;
    }

    document.querySelectorAll('.seat:not(:disabled)').forEach(btn => {
        btn.addEventListener('click', function () {
            const id = parseInt(this.dataset.id);
            if (selected.has(id)) {
                selected.delete(id);
                this.classList.remove('selected');
            } else {
                selected.set(id, {
                    precio: parseFloat(this.dataset.precio),
                    codigo: this.dataset.codigo,
                    zona: this.dataset.zona,
                    fila: this.dataset.fila,
                    numero: this.dataset.numero
                });
                this.classList.add('selected');
            }
            refresh();
        });
    });

    function selectPayment(method) {
        document.getElementById('metodoPago').value = method;
        document.getElementById('btnEfectivo').classList.toggle('active', method === 'efectivo');
        document.getElementById('btnTarjeta').classList.toggle('active', method === 'tarjeta');
    }
</script>
}